# Copy to .env only when overriding these local-development defaults.
POSTGRES_DB=notetaker
POSTGRES_USER=notetaker
POSTGRES_PASSWORD=notetaker
DATABASE_URL=postgresql+asyncpg://notetaker:notetaker@postgres:5432/notetaker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notetaker@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
APP_DEFAULT_EMAIL=demo@example.test
APP_DEFAULT_TIMEZONE=Europe/Budapest
REMINDER_SCAN_INTERVAL_SECONDS=1
REMINDER_GRACE_SECONDS=60
REMINDER_CLAIM_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=1
TRASH_CLEANUP_INTERVAL_SECONDS=3600
MAX_SERIES_OCCURRENCES=10000
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Host publications. Keep loopback defaults for this unauthenticated application.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025

# Read by vite.config.ts inside the frontend container. Browser code still uses /api and /ws.
VITE_PROXY_TARGET=http://backend:8000
